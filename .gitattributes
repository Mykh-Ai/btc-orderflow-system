* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.csv text eol=lf
*.jsonl text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Legacy production snapshot contains mixed historical line endings. Preserve the
# untouched bytes so focused Executor changes do not renormalize the whole file.
executor/executor.py -text whitespace=cr-at-eol

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
